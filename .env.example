NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional, local development only. In production Vercel sets the voter's
# country automatically (x-vercel-ip-country header) — this doesn't exist
# when running `npm run dev` locally, so votes would be rejected with
# "country_unknown" unless you set this to a 2-letter country code to test
# with, e.g. FANMAP_DEV_COUNTRY=SK
FANMAP_DEV_COUNTRY=

# Optional. Minimum votes a country needs before the map colors it (default
# 3). Set to 1 locally to see a single test vote color your country. Leave
# unset in production.
NEXT_PUBLIC_MIN_VOTES_TO_COLOR=

# Optional. Links to OUR social accounts, shown under "Follow" in the footer.
# Leave empty until the account exists — an empty one is simply not shown.
# Must start with https://
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=

# REQUIRED for voting. A long random secret that proves to the database that
# a vote comes from our own server. Server-only — never give it a
# NEXT_PUBLIC_ prefix. Must be the same in .env.local and in Vercel, and its
# fingerprint must be registered in the database (README, "Hlasovanie a
# bezpecnost").
FANMAP_VOTE_SECRET=

# Cloudflare Turnstile — the "are you a human?" check before a vote
# (dash.cloudflare.com -> Turnstile -> your widget). The site key is public;
# the secret key is server-only, never give it a NEXT_PUBLIC_ prefix.
# REQUIRED on the live site (voting answers "temporarily unavailable"
# without the secret key). Locally you can leave both empty to switch the
# check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
