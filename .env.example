NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional, local development only. In production Vercel sets the voter's
# country automatically (x-vercel-ip-country header) — this doesn't exist
# when running `npm run dev` locally, so votes would be rejected with
# "country_unknown" unless you set this to a 2-letter country code to test
# with, e.g. FANMAP_DEV_COUNTRY=SK
FANMAP_DEV_COUNTRY=
